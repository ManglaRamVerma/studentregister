@model IEnumerable<School.Models.Casting.StudentDetails>

@{
    ViewData["Title"] = "Student List";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Details</h4>
            <a asp-action="Register" class="btn btn-light">Add New Student</a>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                    <strong>Success!</strong> @TempData["Success"]
                 
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                    <strong>Error!</strong> @TempData["Error"]
                  
                </div>
            }
           

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Image</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Country</th>
                            <th>State</th>
                            <th>City</th>
                         
                           <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        { 
                            <tr>
                                <td>@student.Id</td>
                                <td>@student.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(student.ImagePath))
                                    {
                                        <img src="@student.ImagePath" width="50" height="50" alt="virat" />
                                    }
                                    else
                                    {
                                        <span>^_^</span>
                                    }
                                </td>

                                <td>@student.Email</td>
                                <td>@student.Phone</td>
                                <td>@student.CountryName</td>
                                <td>@student.StateName</td>
                                <td>@student.CityName</td>

                             
                                <td>
                                   
                                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this student?')">
                                        Delete
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-sm"
                                      >
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $(".alert").fadeOut("slow");
            }, 3000); 
        });
    </script>
}

